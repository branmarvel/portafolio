    <script is:inline>
        lucide.createIcons();

        // ── Photo Toggle ───────────────────────────────
        let showPhoto = true;
        function togglePhoto() {
            showPhoto = !showPhoto;
            const page = document.getElementById('cv-page');
            const btn = document.getElementById('photoBtn');
            if (showPhoto) {
                page.classList.remove('no-photo');
                btn.innerHTML = `<i data-lucide="image"></i> 
                                 <span data-es="Ocultar Foto" data-en="Hide Photo">${currentLang === 'es' ? 'Ocultar Foto' : 'Hide Photo'}</span>`;
            } else {
                page.classList.add('no-photo');
                btn.innerHTML = `<i data-lucide="image-off"></i> 
                                 <span data-es="Mostrar Foto" data-en="Show Photo">${currentLang === 'es' ? 'Mostrar Foto' : 'Show Photo'}</span>`;
            }
            lucide.createIcons();
        }

        // ── Language Toggle ────────────────────────────
        let currentLang = 'es';

        function initLang() {
            const urlParams = new URLSearchParams(window.location.search);
            const urlLang = urlParams.get('lang');
            const savedLang = localStorage.getItem('portfolio_lang');
            
            let detectedLang = 'es';
            if (urlLang === 'es' || urlLang === 'en') {
                detectedLang = urlLang;
            } else if (savedLang === 'es' || savedLang === 'en') {
                detectedLang = savedLang;
            } else {
                const browserLang = navigator.language || navigator.userLanguage;
                detectedLang = browserLang.toLowerCase().includes('es') ? 'es' : 'en';
            }
            
            currentLang = detectedLang;
            localStorage.setItem('portfolio_lang', currentLang);
            updateUIForLang();
        }

        function toggleLang() {
            currentLang = currentLang === 'es' ? 'en' : 'es';
            localStorage.setItem('portfolio_lang', currentLang);
            updateUIForLang();
        }

        function updateUIForLang() {
            const btn = document.getElementById('langBtn');
            if (btn) {
                btn.innerHTML = currentLang === 'es'
                    ? '<i data-lucide="globe"></i> <span>🇬🇧 English</span>'
                    : '<i data-lucide="globe"></i> <span>🇪🇸 Español</span>';
            }

            // Update all elements with data-es / data-en
            document.querySelectorAll('[data-es]').forEach(el => {
                const content = el.getAttribute(`data-${currentLang}`);
                if (content !== null) {
                    if (content.includes('<')) {
                        el.innerHTML = DOMPurify.sanitize(content);
                    } else {
                        el.textContent = content;
                    }
                }
            });

            // Update the show/hide photo button text lang
            const photoBtn = document.getElementById('photoBtn');
            if (photoBtn) {
                if (showPhoto) {
                    photoBtn.querySelector('span').textContent = currentLang === 'es' ? 'Ocultar Foto' : 'Hide Photo';
                } else {
                    photoBtn.querySelector('span').textContent = currentLang === 'es' ? 'Mostrar Foto' : 'Show Photo';
                }
            }

            // Update PDF button text lang
            const dlBtn = document.getElementById('controls').querySelector('.dl span');
            if (dlBtn) {
                dlBtn.textContent = currentLang === 'es' ? 'Exportar PDF' : 'Export PDF';
            }

            // Update CV classic link query param
            const cvLink = document.getElementById('controls').querySelector('.cv-type');
            if (cvLink) {
                cvLink.href = `/cv/classic?lang=${currentLang}`;
            }

            // Update theme button
            updateThemeBtn();
            lucide.createIcons();
            document.documentElement.lang = currentLang;
        }

        function updateThemeBtn() {
            const isDark = document.body.classList.contains('dark-mode') || !document.body.classList.contains('light-mode');
            const btn = document.getElementById('themeBtn');
            if (isDark) {
                btn.innerHTML = `<i data-lucide="sun"></i> 
                                 <span>${currentLang === 'es' ? 'Modo Claro' : 'Light Mode'}</span>`;
            } else {
                btn.innerHTML = `<i data-lucide="moon"></i> 
                                 <span>${currentLang === 'es' ? 'Modo Oscuro' : 'Dark Mode'}</span>`;
            }
            lucide.createIcons();
        }

        function toggleTheme() {
            // Document body theme controls class
            if (document.body.classList.contains('light-mode')) {
                document.body.classList.remove('light-mode');
                document.body.classList.add('dark-mode');
            } else {
                document.body.classList.remove('dark-mode');
                document.body.classList.add('light-mode');
            }
            updateThemeBtn();
        }

        // ── PDF Export ─────────────────────────────────
        function exportPDF() {
            const page = document.getElementById('cv-page');
            const lang = currentLang === 'es' ? 'ES' : 'EN';
            
            // Save original scroll position
            const originalScrollY = window.scrollY;
            const originalScrollX = window.scrollX;
            
            // Scroll to top-left to avoid html2canvas offsets / blank areas
            window.scrollTo(0, 0);
            
            // Add print-mode class to body to force desktop layout for export
            document.body.classList.add('print-mode');
            
            // Temporarily reset styles for PDF capture
            const oldBorderRadius = page.style.borderRadius;
            const oldBoxShadow = page.style.boxShadow;
            
            page.style.borderRadius = '0';
            page.style.boxShadow = 'none';

            const opt = {
                margin: 0,
                filename: `Brandon_Bello_CV_${lang}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: {
                    scale: 3,
                    useCORS: true,
                    letterRendering: true,
                    backgroundColor: '#ffffff',
                    scrollY: 0,
                    scrollX: 0
                },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            
            const pdfName = `Brandon_Bello_CV_${lang}.pdf`;

            html2pdf().set(opt).from(page).output('blob').then((pdfBlob) => {
                const blobUrl = URL.createObjectURL(pdfBlob);
                const link = document.createElement('a');
                link.href = blobUrl;
                link.download = pdfName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(blobUrl);

                // Restore original preview styling
                page.style.borderRadius = oldBorderRadius;
                page.style.boxShadow = oldBoxShadow;
                document.body.classList.remove('print-mode');
                // Restore scroll position
                window.scrollTo(originalScrollX, originalScrollY);
            }).catch(err => {
                console.error("PDF export error", err);
                document.body.classList.remove('print-mode');
                // Restore scroll position
                window.scrollTo(originalScrollX, originalScrollY);
            });
        }

        // Initialize icons and language on DOM load
        window.addEventListener('DOMContentLoaded', () => {
            initLang();
        });
    </script>
