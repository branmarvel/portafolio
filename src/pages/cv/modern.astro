---
import '../../styles/cv/shared.css';
// Astro page configuration
---
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brandon J. Bello Moncada — Modern CV</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <script is:inline src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.8/purify.min.js"></script>
    <style is:global>
        :root {
            --bg: #ffffff;
            --sidebar: #f8fafc;
            --primary: #4f46e5;
            --accent: #6366f1;
            --text: #0f172a;
            --muted: #475569;
            --line: rgba(0, 0, 0, 0.08);
            --pill: rgba(79, 70, 229, 0.1);
        }

        /* ── Dark Mode ── */
        body.dark-mode #cv-page {
            --bg: #0f172a;
            --sidebar: #1e293b;
            --text: #f8fafc;
            --muted: #94a3b8;
            --line: rgba(255, 255, 255, 0.1);
            --pill: rgba(99, 102, 241, 0.2);
        }

        body.dark-mode .tag {
            background: #1e293b;
            color: #94a3b8;
        }

        body.dark-mode .tag.hi {
            background: var(--pill);
            color: var(--accent);
            border-color: var(--accent);
        }

        body {
            font-family: 'Inter', Arial, sans-serif;
            background: #0f172a; /* Consistent dark mode background for screen */
            background-image: radial-gradient(circle at 50% 50%, #1e1b4b 0%, #0f172a 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 90px 16px 40px;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* When exporting to PDF/print, force light backgrounds and default padding */
        body.print-mode {
            background: #ffffff !important;
            background-image: none !important;
            padding: 0 !important;
        }

        .c-item [data-lucide],
        .c-item svg.lucide,
        aside [data-lucide],
        aside svg.lucide {
            width: 12px;
            height: 12px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: transparent;
            color: #e2e8f0;
            border: none;
            padding: 8px 14px;
            border-radius: 9999px;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            white-space: nowrap;
        }

        .btn.dl {
            background: #4f46e5;
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

        .btn.dl:hover {
            background: #6366f1;
            box-shadow: 0 6px 16px rgba(79, 70, 229, 0.4);
        }

        .btn.back:hover {
            background: transparent;
            color: #f43f5e;
        }

        /* ── Page (US Letter 816×1056px at 96dpi) ─ */
        .cv-scaler-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .cv-scaler {
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        #cv-page {
            width: 816px;
            height: 1056px;
            background: var(--bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            border-radius: 8px;
            transition: box-shadow 0.2s ease;
        }

        #cv-page::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(99, 102, 241, .07);
            pointer-events: none;
        }

        /* ── Header ───────────────────────── */
        header {
            display: flex;
            align-items: center;
            gap: 24px;
            padding: 16px 30px 12px;
            border-bottom: 1px solid var(--line);
            flex-shrink: 0;
            position: relative;
            z-index: 1;
            transition: all 0.3s ease;
        }

        .photo-wrap {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            flex-shrink: 0;
            overflow: hidden;
            background: var(--sidebar);
            box-shadow: 0 0 0 3px var(--primary), 0 0 0 6px rgba(99, 102, 241, .20);
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        /* Ocultar Foto Style */
        #cv-page.no-photo .photo-wrap {
            display: none !important;
        }

        .photo-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .header-text {
            flex: 1;
        }

        .header-text h1 {
            font-family: 'Outfit', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            letter-spacing: -0.5px;
            line-height: 1.1;
        }

        .header-text h1 span {
            color: var(--primary);
        }

        .header-text .role {
            font-size: .75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent);
            margin-top: 4px;
        }

        .contact-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 18px;
            flex: 1;
        }

        .c-item {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: .65rem;
            color: var(--accent);
            text-decoration: underline;
            text-underline-offset: 2.5px;
            text-decoration-color: rgba(99, 102, 241, 0.4);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: color 0.15s ease, text-decoration-color 0.15s ease;
        }

        .c-item:hover {
            color: var(--primary);
            text-decoration-color: var(--primary);
        }

        .c-item svg {
            color: var(--accent);
            flex-shrink: 0;
            transition: color 0.15s ease;
        }

        .c-item:hover svg {
            color: var(--primary);
        }

        /* ── Body Grid ────────────────────── */
        .body-grid {
            display: grid;
            grid-template-columns: 210px 1fr;
            flex: 1;
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        /* ── Sidebar ──────────────────────── */
        aside {
            background: var(--sidebar);
            padding: 14px 16px;
            border-right: 1px solid var(--line);
            display: flex;
            flex-direction: column;
            gap: 10px;
            overflow: hidden;
        }

        .s-title {
            font-family: 'Outfit', sans-serif;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 7px;
            padding-bottom: 4px;
            border-bottom: 1px solid var(--line);
        }

        .s-title svg {
            color: var(--accent);
        }

        .skill-cat {
            margin-bottom: 7px;
        }

        .skill-cat h4 {
            font-size: .6rem;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 3px;
        }

        .tag {
            font-size: .6rem;
            padding: 2px 7px;
            border-radius: 4px;
            color: var(--muted);
            border: 1px solid var(--line);
            background: #ffffff;
        }

        .tag.hi {
            color: var(--primary);
            border-color: var(--primary);
            background: var(--pill);
            font-weight: 500;
        }

        .edu-item p {
            font-size: .7rem;
            color: var(--text);
            font-weight: 600;
        }

        .edu-item span {
            font-size: .63rem;
            color: var(--muted);
            display: block;
        }

        .edu-item em {
            font-size: .6rem;
            color: var(--accent);
            font-style: normal;
            display: block;
            margin-top: 3px;
            padding-left: 2px;
        }

        .lang-item {
            font-size: .7rem;
            color: var(--muted);
        }

        .lang-item strong {
            color: var(--text);
        }

        /* ── Main Content ─────────────────── */
        main {
            padding: 14px 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow: hidden;
        }

        .summary {
            font-size: .75rem;
            color: var(--muted);
            line-height: 1.55;
        }

        .summary strong {
            color: var(--text);
        }

        .m-title {
            font-family: 'Outfit', sans-serif;
            font-size: .88rem;
            font-weight: 700;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 5px;
        }

        .m-title svg {
            color: var(--accent);
        }

        .m-title::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--line);
        }

        /* Experience */
        .exp {
            display: grid;
            grid-template-columns: 8px 1fr;
            gap: 0 12px;
            margin-bottom: 6px;
        }

        .exp-line {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--primary);
            flex-shrink: 0;
            margin-top: 4px;
        }

        .v-line {
            width: 1px;
            flex: 1;
            background: var(--line);
            margin-top: 3px;
        }

        .exp-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 2px;
        }

        .exp-head h3 {
            font-size: .8rem;
            font-weight: 600;
            color: var(--text);
        }

        .exp-head .date {
            font-size: .62rem;
            color: var(--accent);
            font-weight: 600;
            white-space: nowrap;
            padding-left: 6px;
        }

        .exp-co {
            font-size: .65rem;
            color: var(--muted);
            font-style: italic;
            margin-bottom: 4px;
            display: block;
        }

        .exp ul {
            list-style: none;
        }

        .exp li {
            font-size: .7rem;
            color: var(--muted);
            padding-left: 11px;
            position: relative;
            margin-bottom: 1.5px;
            line-height: 1.35;
        }

        .exp li::before {
            content: '•';
            position: absolute;
            left: 0;
            color: var(--accent);
        }

        .exp li strong {
            color: var(--text);
            font-weight: 500;
        }

        /* Responsive and Mobile layout (only on screens < 840px and when NOT printing) */
        @media (max-width: 840px) {
            body:not(.print-mode) {
                padding: 30px 12px 110px; /* space for mobile controls dock */
            }

            body:not(.print-mode) .cv-scaler-wrapper,
            body:not(.print-mode) .cv-scaler {
                width: 100% !important;
                height: auto !important;
                display: block !important;
            }

            body:not(.print-mode) #cv-page {
                width: 100% !important;
                height: auto !important;
                max-width: 600px;
                margin: 0 auto;
                transform: none !important;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
                display: block !important;
                overflow: visible !important;
                border-radius: 12px;
            }

            body:not(.print-mode) header {
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 16px;
                padding: 24px 20px;
            }

            body:not(.print-mode) .photo-wrap {
                width: 110px;
                height: 110px;
            }

            body:not(.print-mode) .contact-grid {
                flex-direction: column;
                align-items: center;
                gap: 6px;
                margin-top: 10px;
                width: 100%;
            }

            body:not(.print-mode) .c-item {
                font-size: .8rem;
                padding: 4px 0;
            }

            body:not(.print-mode) .body-grid {
                grid-template-columns: 1fr !important;
                display: block !important;
            }

            body:not(.print-mode) aside {
                border-right: none;
                border-bottom: 1px solid var(--line);
                padding: 24px 20px;
                gap: 16px;
                overflow: visible;
            }

            body:not(.print-mode) .s-title {
                font-size: .85rem;
                margin-bottom: 10px;
            }

            body:not(.print-mode) .tag {
                font-size: .75rem;
                padding: 4px 10px;
            }

            body:not(.print-mode) .edu-item p {
                font-size: .85rem;
            }

            body:not(.print-mode) .edu-item span {
                font-size: .75rem;
            }

            body:not(.print-mode) .edu-item em {
                font-size: .7rem;
            }

            body:not(.print-mode) main {
                padding: 24px 20px;
                gap: 16px;
                overflow: visible;
            }

            body:not(.print-mode) .summary {
                font-size: .82rem;
                line-height: 1.6;
            }

            body:not(.print-mode) .m-title {
                font-size: .95rem;
            }

            body:not(.print-mode) .exp {
                grid-template-columns: 1fr;
                gap: 8px;
                margin-bottom: 16px;
            }

            body:not(.print-mode) .exp-line {
                display: none;
            }

            body:not(.print-mode) .exp-head {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }

            body:not(.print-mode) .exp-head h3 {
                font-size: .9rem;
            }

            body:not(.print-mode) .exp-head .date {
                padding-left: 0;
                font-size: .75rem;
            }

            body:not(.print-mode) .exp-co {
                font-size: .75rem;
            }

            body:not(.print-mode) .exp li {
                font-size: .78rem;
                margin-bottom: 4px;
                line-height: 1.45;
                padding-left: 14px;
            }

            /* Controls Dock on Mobile */
            body:not(.print-mode) #controls {
                width: 92%;
                max-width: 450px;
                top: auto;
                bottom: 24px;
                transform: translateX(-50%);
                justify-content: space-between;
                padding: 8px 16px;
                background: rgba(15, 23, 42, 0.85);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 9999px;
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
            }

            body:not(.print-mode) .btn span {
                display: none !important; /* Force hide button text on mobile */
            }

            body:not(.print-mode) .btn {
                padding: 0;
                margin: 0;
                border-radius: 50% !important;
                width: 42px !important;
                height: 42px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
            }

            body:not(.print-mode) .btn.back {
                border-left: none;
                padding-left: 0;
            }
        }

        @media print {
            /* Force light theme for printing */
            body.dark-mode #cv-page,
            #cv-page {
                --bg: #ffffff !important;
                --sidebar: #f8fafc !important;
                --text: #0f172a !important;
                --muted: #475569 !important;
                --line: rgba(0, 0, 0, 0.08) !important;
                --pill: rgba(79, 70, 229, 0.1) !important;
                transform: none !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                width: 816px !important;
                height: 1056px !important;
                display: flex !important;
                flex-direction: column !important;
            }

            body.dark-mode .tag {
                background: #ffffff !important;
                color: #475569 !important;
                border: 1px solid rgba(0, 0, 0, 0.08) !important;
            }

            body.dark-mode .tag.hi {
                background: rgba(79, 70, 229, 0.1) !important;
                color: #4f46e5 !important;
                border-color: #4f46e5 !important;
            }

            body {
                background: none !important;
                background-image: none !important;
                padding: 0 !important;
                overflow: visible !important;
            }

            .cv-scaler-wrapper, .cv-scaler {
                height: auto !important;
                width: auto !important;
            }

            .body-grid {
                display: grid !important;
                grid-template-columns: 210px 1fr !important;
            }

            header {
                display: flex !important;
                flex-direction: row !important;
            }
        }
    </style>
</head>

<body>

    <!-- Controls Toolbar (Floating Glassmorphism) -->
    <div id="controls">
        <button class="btn theme" onclick="toggleTheme()" id="themeBtn" title="Alternar Modo Oscuro">
            <i data-lucide="moon"></i>
            <span data-es="Modo Oscuro" data-en="Dark Mode">Modo Oscuro</span>
        </button>
        <button class="btn photo" onclick="togglePhoto()" id="photoBtn" title="Mostrar/Ocultar Foto">
            <i data-lucide="image"></i>
            <span data-es="Ocultar Foto" data-en="Hide Photo">Ocultar Foto</span>
        </button>
        <button class="btn lang" onclick="toggleLang()" id="langBtn" title="Cambiar Idioma">
            <i data-lucide="globe"></i>
            <span>🇬🇧 English</span>
        </button>
        <button class="btn dl" onclick="exportPDF()" title="Exportar PDF">
            <i data-lucide="download"></i>
            <span data-es="Exportar PDF" data-en="Export PDF">Exportar PDF</span>
        </button>
        <a class="btn cv-type" href="/cv/classic" title="Ver CV Clásico">
