    <script is:inline>
        let currentLang = 'es';

        // ── Photo Toggle (Initially Hidden in Classic) ─
        let showPhoto = false;
        function togglePhoto() {
            showPhoto = !showPhoto;
            const btn = document.getElementById('photoBtn');
            const containers = document.querySelectorAll('.photo-container');
            
            if (showPhoto) {
                containers.forEach(container => {
                    container.style.display = 'block';
                });
                btn.innerHTML = `<i data-lucide="image"></i> 
                                 <span data-es="Ocultar Foto" data-en="Hide Photo">${currentLang === 'es' ? 'Ocultar Foto' : 'Hide Photo'}</span>`;
            } else {
                containers.forEach(container => {
                    container.style.display = 'none';
                });
                btn.innerHTML = `<i data-lucide="image-off"></i> 
                                 <span data-es="Mostrar Foto" data-en="Show Photo">${currentLang === 'es' ? 'Mostrar Foto' : 'Show Photo'}</span>`;
            }
            lucide.createIcons();
        }

        // ── Language Toggle ────────────────────────────
        function toggleLang() {
            currentLang = currentLang === 'es' ? 'en' : 'es';
            document.getElementById('content-es').style.display = currentLang === 'es' ? '' : 'none';
            document.getElementById('content-en').style.display = currentLang === 'en' ? '' : 'none';
            document.getElementById('htmlRoot').lang = currentLang;
            
            const btn = document.getElementById('langBtn');
            btn.innerHTML = currentLang === 'es'
                ? '<i data-lucide="globe"></i> <span>🇬🇧 English</span>'
                : '<i data-lucide="globe"></i> <span>🇪🇸 Español</span>';

            const pageTitle = document.getElementById('pageTitle');
            pageTitle.textContent = currentLang === 'es'
                ? 'Brandon J. Bello Moncada — Classic CV'
                : 'Brandon J. Bello Moncada — Classic CV (EN)';

            // Update photo button text
            const photoBtn = document.getElementById('photoBtn');
            if (showPhoto) {
                photoBtn.querySelector('span').textContent = currentLang === 'es' ? 'Ocultar Foto' : 'Hide Photo';
            } else {
                photoBtn.querySelector('span').textContent = currentLang === 'es' ? 'Mostrar Foto' : 'Show Photo';
            }

            // Update PDF button text
            const dlBtn = document.getElementById('controls').querySelector('.dl span');
            dlBtn.textContent = currentLang === 'es' ? 'Exportar PDF' : 'Export PDF';

            lucide.createIcons();
        }

        // ── PDF Export (Browser Print Dialog) ──────────
        function exportPDF() {
            // Hide controls
            const controls = document.getElementById('controls');
            controls.style.display = 'none';

            // Open native print dialog (Guarantees selectable text and perfect margins)
            window.print();

            // Restore controls after dialog closes
            setTimeout(() => {
                controls.style.display = '';
            }, 1000);
        }

        // Initialize icons
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
