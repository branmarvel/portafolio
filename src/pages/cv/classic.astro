    <style>
        /* ── RESET & PRINT ─────────────────── */
        @page {
            size: letter;
            margin: 0.45in 0.6in;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 9.5pt;
            color: #111;
            background: #0f172a; /* Consistent dark background matching portfolio */
            background-image: radial-gradient(circle at 50% 50%, #1e1b4b 0%, #0f172a 100%);
            line-height: 1.35;
            padding: 90px 16px 40px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Cinematic Noise Overlay */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            opacity: 0.04;
            pointer-events: none;
            z-index: 9999;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* Icon sizes globally managed for TS safety */
        [data-lucide],
        svg.lucide {
            width: 14px;
            height: 14px;
            stroke-width: 2px;
            display: inline-block;
            vertical-align: middle;
        }

        /* ── Controls Bar (Glassmorphic Premium) ── */
        #controls {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 6px 14px;
            border-radius: 9999px;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5),
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
            z-index: 1000;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: transparent;
            color: #e2e8f0;
            border: none;
            padding: 8px 14px;
            border-radius: 9999px;
            font-family: Arial, sans-serif;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            white-space: nowrap;
        }

        .btn:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn.dl {
            background: #1d4ed8;
            color: #ffffff;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(29, 78, 216, 0.3);
        }

        .btn.dl:hover {
            background: #2563eb;
            box-shadow: 0 6px 16px rgba(29, 78, 216, 0.4);
        }

        .btn.back {
            border-left: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0;
            padding-left: 14px;
        }

        .btn.back:hover {
            background: transparent;
            color: #ef4444;
        }

        /* ── CV Container Sheet ───────────────── */
        #cv-page {
            background: #ffffff;
            color: #111;
            padding: 0.45in 0.6in;
            max-width: 8.5in;
            width: 100%;
            margin: 0 auto;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            border-radius: 4px;
            position: relative;
            transition: all 0.3s ease;
        }

        header {
            text-align: center;
            border-bottom: 1.5pt solid #111;
            padding-bottom: 7pt;
            margin-bottom: 7pt;
        }

        .photo-container {
            position: absolute;
            right: 100%;
            top: 55%;
            transform: translateY(-23%);
            margin-right: 14pt;
            width: 56pt;
            height: 56pt;
            border-radius: 50%;
            border: 1px solid #111;
            overflow: hidden;
            display: none;
            transition: all 0.2s ease;
        }

        .photo-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        header h1 {
            position: relative;
            display: inline-block;
            font-size: 17pt;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        header .subtitle {
            font-size: 9.5pt;
            color: #333;
            margin-top: 4pt;
            font-weight: 600;
        }

        header .contact {
            font-size: 8.5pt;
            color: #333;
            margin-top: 4pt;
            line-height: 1.65;
        }

        header .contact a {
            color: #1d4ed8;
            text-decoration: none;
        }

        /* ── SECTIONS ──────────────────────── */
        section {
            margin-top: 7pt;
        }

        h2 {
            font-size: 10pt;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
            border-bottom: 1pt solid #555;
            padding-bottom: 1.5pt;
            margin-bottom: 4pt;
        }

        p {
            font-size: 9.5pt;
            color: #222;
        }

        /* ── JOBS ──────────────────────────── */
        .job {
            margin-bottom: 6pt;
            page-break-inside: avoid;
        }

        .job-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .job-header h3 {
            font-size: 9.5pt;
            font-weight: 700;
        }

        .job-header .date {
            font-size: 8.5pt;
            color: #444;
            white-space: nowrap;
            padding-left: 6pt;
        }

        .job-company {
            font-size: 8.5pt;
            color: #444;
            font-style: italic;
            display: block;
            margin-bottom: 2pt;
        }

        ul {
            padding-left: 14pt;
            margin-top: 1.5pt;
        }

        li {
            font-size: 8.5pt;
            color: #222;
            margin-bottom: 2pt;
            line-height: 1.35;
        }

        /* ── SKILLS ────────────────────────── */
        .skill-row {
            margin-bottom: 2pt;
            font-size: 8.5pt;
        }

        .skill-row .lbl {
            font-weight: 700;
        }

        /* ── EDU ───────────────────────────── */
        .edu-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .edu-header h3 {
            font-size: 9.5pt;
            font-weight: 700;
        }

        .edu-header .date {
            font-size: 8.5pt;
            color: #444;
        }

        .edu-sub {
            font-size: 8.5pt;
            color: #444;
            font-style: italic;
        }

        /* Responsive Overrides */
        @media screen and (max-width: 840px) {
            body {
                padding: 30px 10px 100px; /* Space for the bottom menu on mobile */
            }
            #cv-page {
                padding: 0.3in 0.4in;
            }
            #controls {
                width: 90%;
                top: auto;
                bottom: 20px;
                transform: translateX(-50%);
                justify-content: space-around;
                padding: 6px 12px;
            }
            .btn span {
                display: none;
            }
            .btn {
                padding: 8px;
                border-radius: 50%;
                width: 38px;
                height: 38px;
                justify-content: center;
            }
            .btn.back {
                border-left: none;
                padding-left: 8px;
            }
            .photo-container {
                position: static !important;
                transform: none !important;
                margin: 0 auto 10px !important;
            }
            header h1 {
                display: block !important;
            }
        }

        @media print {
            body {
                background: none !important;
                background-image: none !important;
                padding: 0 !important;
                overflow: visible !important;
            }

            body::before {
                display: none !important;
            }

            #cv-page {
                padding: 0.45in 0.6in !important;
                box-shadow: none !important;
                max-width: 100% !important;
                border-radius: 0 !important;
            }

            #controls {
                display: none !important;
            }
        }
    </style>
</head>

